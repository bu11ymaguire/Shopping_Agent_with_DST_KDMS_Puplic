# 이 파일을 .env로 복사한 뒤 실제 키를 채운다.
#   Copy-Item .env.example .env
#
# .env는 .gitignore에 등록되어 있다. 커밋하지 않는다.

# ── LLM Provider ─────────────────────────────────────────────
# luxia : 제3자 Luxia Cloud 브리지 (GPT-4o-mini)
# mock  : API 호출 없이 고정 응답. 키 없이 파이프라인·평가 코드를 테스트할 때 쓴다.
LLM_PROVIDER=luxia

# Luxia 대시보드에서 발급받은 키. 기존 예제 이름인 LUXIA_API_KEY도 지원한다.
# 두 변수에 같은 키를 중복 저장하지 말고 하나만 사용한다.
LLM_API_KEY=

# Luxia는 실제 모델을 URL 경로로 결정한다. 마지막 경로 세그먼트가 모델 이름이다.
# 요청은 이 URL 뒤에 /create 를 붙여 보낸다.
LLM_BASE_URL=https://bridge.luxiacloud.com/llm/openai/chat/completions/gpt-4o-mini

# request body의 "model" 필드에 들어가는 값. Luxia에서는 "llm" 고정이다.
# 현재 transport는 luxia와 mock만 지원한다. 공식 OpenAI 연동은 별도 provider 구현이 필요하다.
LLM_MODEL_FIELD=llm

# 연구 로그에 "실제로 어떤 모델을 의도했는지" 남기기 위한 값.
# Luxia는 응답에 model을 에코하지 않을 수 있어 요청 측 기록이 필요하다.
LLM_REQUESTED_MODEL=gpt-4o-mini

# ── 호출 파라미터 ────────────────────────────────────────────
# 구조화 추출은 재현성이 필요하므로 0.0을 쓴다.
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=2048

# ── 재시도 ───────────────────────────────────────────────────
LLM_MAX_RETRIES=5
LLM_INITIAL_BACKOFF_SECONDS=5.0

# ── 로그 ─────────────────────────────────────────────────────
# 노드별 LLM 요청·응답 원본을 JSONL로 남기는 위치.
LLM_LOG_DIR=logs

# ── 실제 리뷰 검색 ──────────────────────────────────────────
# semantic: 고정된 로컬 bi-encoder index + 제한 Cross-Encoder reranking.
#           index/model cache가 없거나 무결성 검증에 실패하면 token으로 fallback한다.
# token   : DuckDB 영어 토큰 일치 baseline만 사용한다.
REVIEW_RETRIEVAL_MODE=semantic

# 기본 index는 실제 catalog Parquet과 같은 Git 제외 디렉터리에 생성한다.
REVIEW_RETRIEVAL_INDEX_DIR=data/amazon_reviews_2023/tablet_catalog_v2
REVIEW_BI_ENCODER_PER_PRODUCT=5
REVIEW_RERANKED_PER_PRODUCT=3
REVIEW_EMBEDDING_BATCH_SIZE=64
REVIEW_RERANKER_BATCH_SIZE=32

# 아래 모델 이름과 commit SHA는 재현성을 위해 고정한다.
REVIEW_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REVIEW_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
REVIEW_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
REVIEW_RERANKER_REVISION=c5ee24cb16019beea0893ab7796b1df96625c6b8
